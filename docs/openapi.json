{
  "openapi": "3.0.3",
  "info": {
    "title": "GymFlow REST API",
    "version": "1.1.0",
    "description": "RESTful API quản lý phòng gym cho môn Phát triển phần mềm hướng dịch vụ"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {}
              }
            }
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 6
          }
        }
      },
      "Member": {
        "type": "object",
        "required": [
          "name",
          "email",
          "phone",
          "gender",
          "birthDate",
          "address",
          "emergencyContact"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string"
          },
          "gender": {
            "type": "string",
            "enum": [
              "Nam",
              "Nữ",
              "Khác"
            ]
          },
          "birthDate": {
            "type": "string",
            "format": "date"
          },
          "address": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ]
          },
          "joinedAt": {
            "type": "string",
            "format": "date"
          },
          "emergencyContact": {
            "type": "string"
          }
        }
      },
      "Plan": {
        "type": "object",
        "required": [
          "name",
          "description",
          "durationDays",
          "price"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "durationDays": {
            "type": "integer",
            "minimum": 1
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ]
          },
          "popular": {
            "type": "boolean"
          }
        }
      },
      "MembershipRequest": {
        "type": "object",
        "required": [
          "memberId",
          "planId",
          "startDate"
        ],
        "properties": {
          "memberId": {
            "type": "integer"
          },
          "planId": {
            "type": "integer"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "expired",
              "cancelled"
            ]
          }
        }
      },
      "CheckinRequest": {
        "type": "object",
        "required": [
          "memberId"
        ],
        "properties": {
          "memberId": {
            "type": "integer"
          }
        }
      },
      "PaymentRequest": {
        "type": "object",
        "required": [
          "memberId",
          "amount",
          "method"
        ],
        "properties": {
          "memberId": {
            "type": "integer"
          },
          "membershipId": {
            "type": "integer"
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "method": {
            "type": "string",
            "enum": [
              "cash",
              "transfer",
              "card"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "paid",
              "pending",
              "refunded"
            ]
          }
        }
      },
      "ScheduleRequest": {
        "type": "object",
        "required": [
          "title",
          "memberId",
          "trainerId",
          "startAt",
          "endAt",
          "type"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "memberId": {
            "type": "integer"
          },
          "trainerId": {
            "type": "integer"
          },
          "startAt": {
            "type": "string",
            "format": "date-time"
          },
          "endAt": {
            "type": "string",
            "format": "date-time"
          },
          "type": {
            "type": "string",
            "enum": [
              "PT",
              "Group"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "completed",
              "cancelled"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      },
      "Trainer": {
        "type": "object",
        "required": [
          "name",
          "email",
          "phone",
          "specialty",
          "experience"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string"
          },
          "specialty": {
            "type": "string"
          },
          "experience": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ]
          }
        }
      },
      "UserRequest": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 6
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "trainer"
            ]
          }
        }
      }
    }
  },
